---
import { formatDate } from '../utils/date';
import { optimizeImagePath } from '../utils/optimizeImagePath';

interface Props {
  post: {
    id: string;
    url: string;
    frontmatter: {
      title: string;
      date: string;
      excerpt: string;
      image?: string;
      tags?: string[];
    };
  };
  showExcerpt?: boolean;
  showTags?: boolean;
}

const { post, showExcerpt = true, showTags = true } = Astro.props;
const { title, date, excerpt, image, tags } = post.frontmatter;

const PLACEHOLDER = '/images/post-default.svg';
const resolvedImage = image ? optimizeImagePath(image) : PLACEHOLDER;
---

<article
  class="brutal-card mb-8 last:mb-0"
  transition:name={`post-${post.id}`}
  style="padding: 0;"
>
  <div class="flex flex-col sm:flex-row gap-0">
    <a
      href={post.url}
      class="block sm:min-w-[180px] sm:w-[180px] aspect-square sm:aspect-auto sm:h-auto overflow-hidden no-underline shrink-0"
      style="border-right: 3px solid var(--color-ink); background: var(--color-surface-container);"
      aria-label={`View ${title} article`}
    >
      <img
        src={resolvedImage}
        alt={image ? `Preview image for ${title}` : 'DailyAi default cover'}
        class="w-full h-full object-cover"
        loading="lazy"
        decoding="async"
        width="180"
        height="180"
      />
    </a>

    <div class="flex-1 p-6">
      <div class="flex flex-col sm:flex-row sm:justify-between sm:items-baseline gap-2 mb-3">
        <h2 class="text-xl md:text-2xl font-bold leading-tight m-0">
          <a href={post.url} class="no-underline">{title}</a>
        </h2>
        <time
          datetime={new Date(date).toISOString()}
          class="ui-sans text-xs uppercase tracking-widest shrink-0"
          style="color: var(--color-on-surface-variant);"
        >
          {formatDate(date)}
        </time>
      </div>

      {showTags && tags && tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-3" aria-label="Tags">
          {tags.map((tag) => (
            <a href={`/tags/${tag}`} class="tag">{tag}</a>
          ))}
        </div>
      )}

      {showExcerpt && excerpt && (
        <p class="m-0 mb-3" style="color: var(--color-on-surface-variant);">{excerpt}</p>
      )}

      <a href={post.url} class="ui-sans text-sm font-semibold uppercase tracking-wider no-underline" style="color: var(--color-primary);">
        Read post →
      </a>
    </div>
  </div>
</article>
