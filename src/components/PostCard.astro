---
import { formatDate } from '../utils/date';
import { optimizeImagePath } from '../utils/optimizeImagePath';

interface Props {
  post: {
    id: string;
    url: string;
    frontmatter: {
      title: string;
      date: string;
      excerpt: string;
      image?: string;
      tags?: string[];
    };
  };
  showImage?: boolean;
  showExcerpt?: boolean;
  showTags?: boolean;
}

const { post, showImage = true, showExcerpt = true, showTags = true } = Astro.props;
const { title, date, excerpt, image, tags } = post.frontmatter;

// Always render an image when showImage is true — fall back to the brutalist
// placeholder SVG when the post doesn't have one of its own.
const PLACEHOLDER = '/images/post-default.svg';
const resolvedImage = image ? optimizeImagePath(image) : PLACEHOLDER;
---

<article
  class="brutal-card mb-10 last:mb-0"
  transition:name={`post-${post.id}`}
  style="padding: 0;"
>
  <div class="p-6 md:p-8">
    <div class="flex flex-col md:flex-row md:justify-between md:items-baseline gap-3 mb-4">
      <h2 class="text-2xl md:text-3xl font-bold leading-tight m-0">
        <a href={post.url} class="no-underline">
          {title}
        </a>
      </h2>
      <time
        datetime={new Date(date).toISOString()}
        class="ui-sans text-xs uppercase tracking-widest shrink-0"
        style="color: var(--color-on-surface-variant);"
      >
        {formatDate(date)}
      </time>
    </div>

    {showTags && tags && tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-5" aria-label="Tags">
        {tags.map((tag) => (
          <a href={`/tags/${tag}`} class="tag" aria-label={`View all posts tagged ${tag}`}>
            {tag}
          </a>
        ))}
      </div>
    )}

    {showImage && (
      <a
        href={post.url}
        class="block feature-image mb-5 no-underline"
        aria-label={`View ${title} article`}
        style="background: transparent;"
      >
        <img
          src={resolvedImage}
          alt={image ? `Preview image for ${title}` : 'DailyAi default cover'}
          loading="lazy"
          decoding="async"
          width="800"
          height="450"
        />
      </a>
    )}

    {showExcerpt && excerpt && (
      <>
        <p class="m-0 mb-5" style="color: var(--color-on-surface-variant);">{excerpt}</p>
        <a href={post.url} class="btn-secondary btn-sm" aria-label={`Read more about ${title}`}>
          Read post →
        </a>
      </>
    )}
  </div>
</article>
