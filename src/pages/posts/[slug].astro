---
import { decodeSlug } from 'emdash';
import { getPublishedPosts, neighbours } from '../../lib/posts';
import PostLayout from '../../layouts/PostLayout.astro';
import PostBody from '../../components/PostBody.astro';

// Rendered on request from EmDash, so a post published in the admin is live
// immediately. Same URL as the old static route: /posts/<slug>.
const slug = decodeSlug(Astro.params.slug);
const posts = slug ? await getPublishedPosts() : [];
const entry = posts.find((p) => p.id === slug);

if (!entry) {
  return Astro.rewrite('/404');
}

const { prevPost, nextPost } = neighbours(posts, entry.id);
---

<PostLayout frontmatter={entry.data} prevPost={prevPost} nextPost={nextPost}>
  <PostBody value={entry.content} />
</PostLayout>
