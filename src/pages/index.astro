---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { getCollection } from 'astro:content';

// Get all blog posts and sort them by date
const allPosts = await getCollection('posts');
const sortedPosts = allPosts.sort((a, b) => {
  return new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf();
});

// Show up to 5 posts on the frontpage
const posts = sortedPosts.slice(0, 5).map(post => ({
  ...post,
  url: `/posts/${post.id}`,
  frontmatter: post.data
}));
---

<BaseLayout title="Home">
  <div class="max-w-4xl mx-auto px-6">
    <section class="py-16 md:py-24" transition:animate="fade">
      <span class="tag tag--primary mb-6">// AI &amp; No-Code</span>
      <h1 class="text-5xl md:text-7xl font-bold leading-[1.05] mb-6 mt-4" style="letter-spacing: -0.03em;">
        Welcome to <span style="color: var(--color-primary);">DailyAi.</span>
      </h1>
      <p class="text-xl md:text-2xl max-w-2xl mb-10" style="color: var(--color-on-surface-variant); font-family: 'Newsreader', serif;">
        Blog posts about how you can start using AI today — practical workflows
        for the rest of us.
      </p>
      <a href="/journal" class="btn-primary btn-lg">
        Read latest posts →
      </a>
    </section>

    <section class="mb-24" transition:animate="fade">
      <div class="flex items-baseline justify-between mb-8 pb-4" style="border-bottom: 3px solid var(--color-ink);">
        <h2 class="ui-sans text-2xl md:text-3xl font-bold uppercase tracking-tight m-0">Latest Entries</h2>
        <a href="/journal" class="ui-sans text-sm font-semibold uppercase tracking-widest no-underline" style="color: var(--color-primary);">
          View all →
        </a>
      </div>

      <PostList posts={posts} showImages={true} showExcerpt={true} showTags={false}/>
    </section>
  </div>
</BaseLayout>
