---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostListWithThumbnails from '../components/PostListWithThumbnails.astro';
import { getPublishedPosts } from '../lib/posts';

// Get all blog posts and sort them by date
const allPosts = await getPublishedPosts();
const sortedPosts = allPosts.sort((a, b) => {
  return new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf();
});

// Format posts for the PostList component
const posts = sortedPosts.map(post => ({
  ...post,
  url: `/posts/${post.id}`,
  frontmatter: post.data
}));
---

<BaseLayout title="Journal" mdAlternate="/journal.md">
  <div class="max-w-3xl mx-auto px-6">
    <header class="mb-12 pt-6" transition:animate="fade">
      <span class="tag tag--primary mb-4">// All Posts</span>
      <h1 class="text-5xl md:text-6xl font-bold leading-tight mt-4 mb-4" style="letter-spacing: -0.02em;">Journal</h1>
      <p class="text-xl" style="color: var(--color-on-surface-variant); font-family: 'Newsreader', serif;">
        Practical writing on AI, no-code, and the workflows that actually save time.
      </p>
      <hr class="mt-8" />
    </header>

    <div transition:animate="fade">
      <PostListWithThumbnails posts={posts} showTags={true} />
    </div>
  </div>
</BaseLayout>
