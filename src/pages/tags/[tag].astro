---
import { getPublishedPosts } from '../../lib/posts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';

// Rendered on request from EmDash's `tag` taxonomy. Same URL as before:
// /tags/<tag>.
const { tag } = Astro.params;
const posts = (await getPublishedPosts()).filter((post) => tag && post.data.tags.includes(tag));

if (posts.length === 0) {
  return Astro.rewrite('/404');
}

// Sort posts by date
const sortedPosts = posts.sort((a, b) => 
  new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
);

// Format posts for the PostList component
const formattedPosts = sortedPosts.map(post => ({
  ...post,
  url: `/posts/${post.id}`,
  frontmatter: post.data
}));
---

<BaseLayout title={`Posts tagged with "${tag}"`}>
  <div class="max-w-3xl mx-auto">
    <header class="mb-12 text-center">
      <h1 class="text-5xl mb-4">Tag: {tag}</h1>
      <p class="text-xl text-muted-foreground">
        {posts.length} {posts.length === 1 ? 'post' : 'posts'} tagged with "{tag}"
      </p>
    </header>

    <PostList posts={formattedPosts} />
    
    <div class="mt-12 text-center">
      <a href="/journal" class="cta-button">
        View All Posts
      </a>
    </div>
  </div>
</BaseLayout>
