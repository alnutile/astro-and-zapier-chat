{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dailyai-blog",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	// Posts, tags, users, revisions. Created on first deploy if it doesn't exist.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "dailyai-blog"
		}
	],
	// Media uploaded through the EmDash admin.
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "dailyai-blog-media"
		}
	],
	// Scheduled publishing + EmDash maintenance tasks.
	"triggers": {
		"crons": ["* * * * *"]
	},
	"observability": { "enabled": true }
}
